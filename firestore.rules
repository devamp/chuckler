rules_version = '2';

// Slice 1 and 2 rules (see docs/data-model.md). The legacy collections
// (Comments, Notifications and the legacy Users fields) stay open to any
// signed-in user until their slices replace them. Anything not matched here
// is denied. Tested by functions/test/rules.test.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Only these keys changed between the stored doc and the write.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- Prompts -------------------------------------------------------

    // A like or unlike: the writer adds (or removes) only their own uid in
    // likedBy, and counts.likes moves by exactly 1 to match. Nothing else
    // on the prompt changes.
    function isLikeToggle() {
      let me = request.auth.uid;
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      let likesBefore = resource.data.get('counts', {}).get('likes', 0);
      let likesAfter = request.resource.data.get('counts', {}).get('likes', 0);
      let countsOnlyLikes = request.resource.data.get('counts', {})
          .diff(resource.data.get('counts', {})).affectedKeys().hasOnly(['likes']);
      let like = !(me in before)
          && after.size() == before.size() + 1
          && after.toSet() == before.toSet().union([me].toSet())
          && likesAfter == likesBefore + 1;
      let unlike = (me in before)
          && after.size() == before.size() - 1
          && after.toSet() == before.toSet().difference([me].toSet())
          && likesAfter == likesBefore - 1;
      return onlyChanged(['likedBy', 'counts']) && countsOnlyLikes && (like || unlike);
    }

    match /PromptDays/{dayId} {
      allow read: if signedIn();

      match /Prompts/{promptId} {
        allow read: if signedIn();
        allow update: if signedIn() && isLikeToggle();
      }
    }

    // ---- Friend prompts ------------------------------------------------

    // Today's prompt day id (yyyy-MM-dd), which rolls over at 05:00 UTC
    // like lib/data/prompt_day.dart
    function isToday(dayId) {
      let d = request.time - duration.value(5, 'h');
      return dayId is string && dayId.size() == 10
          && int(dayId[0:4]) == d.year()
          && int(dayId[5:7]) == d.month()
          && int(dayId[8:10]) == d.day();
    }

    function promptPart(s) {
      return s is string && s.size() <= 120;
    }

    // A prompt a user writes for their friends, one per user per day: the
    // id is {uid}_{dayId} and docs are never rewritten. The creator writes
    // it without an audience; onFriendPromptCreated fills that in from
    // their Friends, since rules can't check a list of friends.
    match /FriendPrompts/{promptId} {
      allow read: if signedIn()
          && (request.auth.uid in resource.data.get('audience', [])
              || resource.data.creator.uid == request.auth.uid);
      allow create: if signedIn() && isNewFriendPrompt(promptId);
      allow update: if signedIn()
          && request.auth.uid in resource.data.get('audience', [])
          && isLikeToggle();
      allow delete: if false;
    }

    function isNewFriendPrompt(promptId) {
      let d = request.resource.data;
      let me = request.auth.uid;
      let c = d.get('counts', {});
      return d.keys().hasOnly(['before', 'after', 'kind', 'dayId', 'createdAt',
              'creator', 'status', 'counts', 'likedBy'])
          && promptId == me + '_' + d.dayId
          && isToday(d.dayId)
          && promptPart(d.before) && promptPart(d.after)
          && d.before.size() + d.after.size() > 0
          && d.kind == 'fill'
          && d.status == 'active'
          && d.createdAt == request.time
          && d.creator.keys().hasOnly(['uid', 'username', 'photoUrl'])
          && d.creator.uid == me
          && d.creator.username == get(/databases/$(database)/documents/Users/$(me)).data.username
          && d.creator.get('photoUrl', '') is string
          && c is map && c.keys().hasOnly(['answers', 'likes', 'dislikes'])
          && c.get('answers', 0) == 0 && c.get('likes', 0) == 0
          && c.get('dislikes', 0) == 0
          && d.get('likedBy', []) == [];
    }

    // ---- Reports -------------------------------------------------------

    // Anyone signed in can report content or a person; nobody can read or
    // change reports from the app. onReportCreated counts them in
    // Moderation (no client access) and hides content past a threshold.
    match /Reports/{id} {
      allow create: if signedIn() && isReport(request.resource.data);
      allow read, update, delete: if false;
    }

    function isReport(d) {
      return d.keys().hasOnly(['reporter', 'targetType', 'targetId', 'postId',
              'matchupId', 'commentId', 'reason', 'note', 'at'])
          && d.reporter == request.auth.uid
          && d.targetType in ['answer', 'comment', 'prompt', 'user']
          && d.targetId is string && d.targetId.size() > 0
          && d.targetId.size() <= 200
          && d.reason in ['offensive', 'harassment', 'sexual', 'spam', 'other']
          && d.get('note', '') is string && d.get('note', '').size() <= 300
          && d.get('postId', '') is string && d.get('matchupId', '') is string
          && d.get('commentId', '') is string
          && d.at == request.time;
    }

    // ---- Leaderboards --------------------------------------------------

    // The global boards: a daily snapshot written by the server (finishDay)
    // with usernames, photos and values only. Anyone signed in reads them.
    match /Leaderboards/{board} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Usernames -----------------------------------------------------

    // One doc per name, so names are unique. Claim a free name for yourself;
    // never change a claim; release only your own.
    match /Usernames/{name} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid']);
      allow update: if false;
      allow delete: if isUser(resource.data.uid);
    }

    // ---- Users ---------------------------------------------------------

    match /Users/{uid} {
      allow read: if signedIn();
      // Legacy: friend requests write other users' docs. Tighten in the
      // friends slice. Official accounts are written only by the server.
      allow create, update, delete: if signedIn() && uid != 'chuckler';

      // bio, stats, streak: kept by Cloud Functions. Friends get read
      // access in the friends slice. The one client write is signup
      // (registerNewUser) creating the profile empty: no bio text, zero
      // answers, no streak.
      match /FriendView/{doc} {
        // you, or a friend (someone in your Friends list; friendship is
        // mutual, so either list would do)
        allow read: if isUser(uid) || (signedIn() && exists(
            /databases/$(database)/documents/Users/$(uid)/Friends/$(request.auth.uid)));
        allow create: if isUser(uid) && doc == 'profile'
            && request.resource.data.keys().hasOnly(['bio', 'stats'])
            && request.resource.data.get('bio', '') == ''
            && request.resource.data.get('stats', {}).keys().hasOnly(['answers'])
            && request.resource.data.get('stats', {}).get('answers', 0) == 0;
        allow update, delete: if false;
      }

      match /Private/{doc} {
        allow read, write: if isUser(uid);
      }

      // A month of the user's answers. Only the owner adds to it.
      // Notifications: written only by functions (friend requests, new
      // friends, awards, comments, daily results). The owner reads them,
      // marks them seen and can delete them.
      match /Notifications/{id} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['seen'])
            && request.resource.data.seen == true;
        allow create: if false;
      }

      match /History/{month} {
        allow read, create, update: if isUser(uid);
        allow delete: if false;
      }

      // Friend requests sent by username. Only the sender writes theirs,
      // under their own uid; the recipient reads them and declines by
      // deleting; the sender can cancel.
      // People this user blocked. Only they see the list; onBlockCreated
      // unfriends them and keeps the blocked user's matchups out of the
      // queue. The blocked user isn't told.
      match /Blocked/{other} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid) && other != uid
            && request.resource.data.keys().hasOnly(['uid', 'username', 'photoUrl', 'at'])
            && request.resource.data.uid == other
            && request.resource.data.username is string
            && request.resource.data.get('photoUrl', '') is string
            && request.resource.data.at == request.time;
        allow update: if false;
      }

      match /FriendRequests/{fromUid} {
        allow read: if isUser(uid);
        allow create: if isUser(fromUid) && fromUid != uid && uid != 'chuckler'
            && exists(/databases/$(database)/documents/Users/$(uid))
            && !exists(/databases/$(database)/documents/Users/$(uid)/Friends/$(fromUid))
            // neither has blocked the other
            && !exists(/databases/$(database)/documents/Users/$(uid)/Blocked/$(fromUid))
            && !exists(/databases/$(database)/documents/Users/$(fromUid)/Blocked/$(uid))
            && isRequestCard(fromUid);
        allow delete: if isUser(uid) || isUser(fromUid);
      }

      // Mutual friends, one doc on each side. The accepter writes both in
      // one batch, while a request from the other person still exists (the
      // batch also deletes it; exists() sees the state before the batch).
      // Either side can unfriend by deleting both.
      match /Friends/{friendUid} {
        allow read: if isUser(uid);
        allow create: if friendCard(friendUid)
            && ((isUser(uid) && requestFrom(friendUid))
                || (isUser(friendUid) && requestFrom(uid)));
        allow delete: if isUser(uid) || isUser(friendUid);
      }
    }

    // The signed-in user's email as EmailRequests ids it: SHA-256 hex of the
    // lowercased address. The database never holds the address itself.
    function myEmailHash() {
      return hashing.sha256(string(request.auth.token.get('email', '')).lower())
          .toHexString().lower();
    }

    // A request from `fromUid` to the signed-in user, by username or email
    function requestFrom(fromUid) {
      return exists(/databases/$(database)/documents/Users/$(request.auth.uid)/FriendRequests/$(fromUid))
          || exists(/databases/$(database)/documents/EmailRequests/$(myEmailHash())/From/$(fromUid));
    }

    // A request doc carrying the sender's real username
    function isRequestCard(fromUid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['username', 'photoUrl', 'sentAt'])
          && d.username == get(/databases/$(database)/documents/Users/$(fromUid)).data.username
          && d.get('photoUrl', '') is string;
    }

    // A Friends doc naming the friend by their real username
    function friendCard(friendUid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['username', 'photoUrl', 'since'])
          && d.username == get(/databases/$(database)/documents/Users/$(friendUid)).data.username
          && d.get('photoUrl', '') is string;
    }

    // ---- Friend requests by email --------------------------------------

    // Sent to an email's hash, so the sender learns nothing about whether an
    // account has that email. Only the owner of that email can read them.
    match /EmailRequests/{hash}/From/{fromUid} {
      allow read: if signedIn() && hash == myEmailHash();
      allow create: if isUser(fromUid) && hash != myEmailHash()
          && isRequestCard(fromUid);
      allow delete: if (signedIn() && hash == myEmailHash()) || isUser(fromUid);
    }

    // ---- Posts (answers) -----------------------------------------------

    // Every counter a new post may carry must start at 0.
    function isZero(m, key) {
      return m.get(key, 0) == 0;
    }

    // An answer to a friend prompt: you're in its audience, and the answer
    // belongs to the prompt's day
    function canAnswerFriendPrompt() {
      let d = request.resource.data;
      let p = get(/databases/$(database)/documents/FriendPrompts/$(d.promptId)).data;
      return request.auth.uid in p.get('audience', [])
          && d.promptDateId == p.dayId;
    }

    function zeroCounts() {
      let d = request.resource.data;
      let c = d.get('counts', {});
      return c is map
          && c.keys().hasOnly(['matchups', 'votes', 'wins', 'dislikes', 'likes', 'comments'])
          && isZero(c, 'matchups') && isZero(c, 'votes') && isZero(c, 'wins')
          && isZero(c, 'dislikes') && isZero(c, 'likes') && isZero(c, 'comments')
          // legacy counters
          && isZero(d, 'likes') && isZero(d, 'dislikes') && isZero(d, 'wins')
          && d.get('likedBy', []).size() == 0;
    }

    // A dislike from the voter's batch: counts.dislikes goes up by exactly 1
    // and nothing else changes, and the same batch creates this user's
    // Dislikes doc for the post, which didn't exist before. So an answer is
    // disliked once per user and the author sees only the count.
    function isDislike(postId) {
      let d = /databases/$(database)/documents/Dislikes/$(postId + '_' + request.auth.uid);
      let before = resource.data.get('counts', {});
      let after = request.resource.data.get('counts', {});
      return onlyChanged(['counts'])
          && after.diff(before).affectedKeys().hasOnly(['dislikes'])
          && after.get('dislikes', 0) == before.get('dislikes', 0) + 1
          && !exists(d) && existsAfter(d);
    }

    match /Posts/{postId} {
      // Legacy: the feed reads everyone's posts. Friends-only later.
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.uid) && zeroCounts()
          && (request.resource.data.get('promptSource', 'daily') != 'friends'
              || canAnswerFriendPrompt());
      // Legacy voting bumps likes/wins from the client; counts and the
      // author belong to the server, apart from an anonymous dislike.
      allow update: if signedIn()
          && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['counts', 'uid'])
              || isDislike(postId));
      allow delete: if isUser(resource.data.uid);

      // An answer's comments, ~200 per page. Anyone signed in can read them.
      // Only someone who voted on a matchup with this answer can comment:
      // a write adds exactly one comment, named by `last`, carrying the
      // writer's uid and the matchup they voted on. Counts and previews are
      // kept by onCommentPageWritten.
      match /CommentPages/{page} {
        allow read: if signedIn();
        allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['comments', 'last'])
            && request.resource.data.comments.keys().toSet()
                == [request.resource.data.last].toSet()
            && isOwnComment(postId, request.resource.data.comments[request.resource.data.last]);
        allow update: if signedIn()
            && onlyChanged(['comments', 'last'])
            && request.resource.data.comments.diff(resource.data.comments).affectedKeys()
                == [request.resource.data.last].toSet()
            && !(request.resource.data.last in resource.data.comments)
            && isOwnComment(postId, request.resource.data.comments[request.resource.data.last]);
      }
    }

    // A new comment by the writer on postId, made after voting on a matchup
    // that contains postId.
    function isOwnComment(postId, c) {
      return c is map
          && c.keys().hasOnly(['uid', 'username', 'text', 'matchupId', 'at'])
          && c.uid == request.auth.uid
          && c.text is string && c.text.size() > 0 && c.text.size() <= 500
          && exists(/databases/$(database)/documents/Votes/$(c.matchupId + '_' + request.auth.uid))
          && postId in get(/databases/$(database)/documents/MatchUps/$(c.matchupId)).data.postIds;
    }

    // ---- Voting --------------------------------------------------------

    // Matchups are anonymous and written only by Cloud Functions.
    // Private/owners (the authors' uids) has no rule, so clients can't read it.
    // Matchups for friend prompts (scope "friends") are only for the
    // prompt's audience. Queries must say so: Home asks for scope ==
    // "public", or for audience array-contains the user.
    match /MatchUps/{matchupId} {
      allow read: if signedIn()
          && (resource.data.scope == 'public'
              || request.auth.uid in resource.data.audience);

      // Who wrote each answer, revealed once you've voted on the matchup
      match /Authors/{doc} {
        allow read: if signedIn() && exists(
            /databases/$(database)/documents/Votes/$(matchupId + '_' + request.auth.uid));
      }
    }

    // One vote per user per matchup, final: create only, never changed.
    // Not on a matchup with your own answer. A downvote must come in the
    // same batch as the anonymous dislike on that answer.
    match /Votes/{voteId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && isNewVote(voteId);
    }

    function isNewVote(voteId) {
      let v = request.resource.data;
      let m = get(/databases/$(database)/documents/MatchUps/$(v.matchupId)).data;
      let owners = get(/databases/$(database)/documents/MatchUps/$(v.matchupId)/Private/owners).data;
      return v.keys().hasOnly(['uid', 'matchupId', 'card', 'type', 'promptDateId', 'at'])
          && v.uid == request.auth.uid
          && voteId == v.matchupId + '_' + request.auth.uid
          && v.card in [0, 1]
          && v.type in ['win', 'dislike']
          && v.promptDateId == m.promptDateId
          && !(request.auth.uid in owners.uids)
          && (m.get('scope', 'public') != 'friends'
              || request.auth.uid in m.get('audience', []))
          && (v.type == 'win' || existsAfter(
              /databases/$(database)/documents/Dislikes/$(m.postIds[v.card] + '_' + request.auth.uid)));
    }

    // Anonymous dislikes, one per user per answer. Only the disliker can
    // read theirs. Dislikes from voting are final, so no delete yet.
    match /Dislikes/{dislikeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'targetId', 'targetType', 'matchupId', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.targetType == 'post'
          && dislikeId == request.resource.data.targetId + '_' + request.auth.uid;
    }

    // ---- Legacy collections, open to signed-in users ---------------------

    match /Comments/{document=**} {
      allow read, write: if signedIn();
    }

    match /Notifications/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
